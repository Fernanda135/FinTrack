# ─────────────────────────────────────────────────────────────
# FinTrack backend environment (copy to .env and fill in)
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Matches the bundled docker-compose.yml:
#   postgresql://fintrack:fintrack@localhost:5432/fintrack?schema=public
DATABASE_URL="postgresql://fintrack:fintrack@localhost:5432/fintrack?schema=public"

# JWT signing secrets — MUST be long, random and distinct in production.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Token lifetimes (ms/vercel format).
JWT_ACCESS_TTL="900s"
JWT_REFRESH_TTL="7d"

# HTTP port the API listens on. (3000 is commonly taken; FinTrack defaults to 3333.)
PORT="3333"

# Comma-separated list of allowed CORS origins (the Expo web app).
# Expo web (expo start --web) typically serves on 8081; 19006 is the legacy port.
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"
