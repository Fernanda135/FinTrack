{
  "expo": {
    "name": "FinTrack",
    "slug": "FinTrack",
    "scheme": "fintrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-fintrack.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon-fintrack.png",
      "resizeMode": "contain",
      "backgroundColor": "#222222"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-fintrack.png",
        "backgroundColor": "#222222"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.fernanda_22.FinTrack"
    },
    "web": {
      "favicon": "./assets/icon-fintrack.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "51b1d990-7fbc-41a4-a817-566380057204"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/51b1d990-7fbc-41a4-a817-566380057204",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
