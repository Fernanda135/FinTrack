# Base URL of the FinTrack backend API.
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time
# (they are NOT secret — never put tokens/passwords here).
#
# Web / same-machine: http://localhost:3333/api
# Physical device:    replace "localhost" with your machine's LAN IP, e.g. http://192.168.0.10:3333/api
# EXPO_PUBLIC_API_URL=http://localhost:3333/api

EXPO_PUBLIC_API_URL=http://192.168.100.170:3333/api
# EXPO_PUBLIC_API_URL=https://fintrack-backend-hfm3.onrender.com/api